        <div style="font-size:2rem;margin-bottom:.5rem">🎓</div>
        <div style="font-size:.8rem;font-weight:700;margin-bottom:.3rem">لا توجد شهادات بعد</div>
        <div style="font-size:.72rem;margin-bottom:.85rem">أكمل دورة كاملة لتحصل على شهادتك</div>
        <button class="btn bgo" onclick="goP('p-halls')">ابدأ التعلم الآن</button>
      </div>
    </div>
    <!-- نموذج شهادة للمعاينة -->
    <div id="cert-preview" style="display:none">
      <div class="cert-wrap">
        <div class="cert-logo">🕌</div>
        <div class="cert-mn">منارة المعرفة</div>
        <div class="cert-title">Manarat Al-Maarifa</div>
        <div style="width:60px;height:2px;background:linear-gradient(90deg,transparent,var(--go),transparent);margin:.5rem auto"></div>
        <div class="cert-hdr">تُشهد هذه الشهادة بأن</div>
        <div class="cert-name" id="cert-student-name">—</div>
        <div class="cert-course">قد أتمّ بنجاح دورة <strong id="cert-course-name">—</strong></div>
        <div class="cert-date" id="cert-date">—</div>
        <div class="cert-seal">🏅</div>
        <div class="cert-id" id="cert-id">رقم الشهادة: MM-000000</div>
      </div>
      <div style="padding:0 1rem .85rem;display:flex;gap:.5rem">
        <button class="btn bgo" style="flex:1" onclick="downloadCert()">⬇️ تحميل PDF</button>
        <button class="btn bgh" style="flex:1" onclick="shareCert()">📤 مشاركة</button>
      </div>
    </div>
  </div>
  <div class="pg" id="p-progress">
