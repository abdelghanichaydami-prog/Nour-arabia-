      <div class="fg"><label class="fl">رابط فيديو تعريفي (YouTube)</label>
        <input type="url" class="fc" id="my-video" placeholder="https://youtube.com/watch?v=..." dir="ltr">
        <div style="font-size:.62rem;color:var(--tm);margin-top:.25rem">سجّل فيديو 1-3 دقائق تعرّف فيه بنفسك وأسلوبك في التدريس</div>
      </div>

      <div class="fg"><label class="fl">نبذة شخصية مفصّلة</label>
        <textarea class="fc" id="my-bio" rows="5" placeholder="أخبر الطلاب عن نفسك: خبرتك، أسلوبك في التدريس، إنجازاتك، وما يميزك..." style="resize:vertical"></textarea>
      </div>

      <div class="fg"><label class="fl">المؤهل العلمي والشهادات</label>
        <input type="text" class="fc" id="my-qual" placeholder="مثال: ليسانس في الشريعة الإسلامية — جامعة القرويين 2015">
      </div>

      <div class="fg"><label class="fl">سنوات الخبرة في التدريس</label>
        <select class="fc" id="my-exp">
          <option>أقل من سنة</option>
          <option>1-2 سنة</option>
          <option>3-5 سنوات</option>
          <option>6-10 سنوات</option>
          <option>أكثر من 10 سنوات</option>
        </select>
      </div>

      <div class="fg"><label class="fl">البلد والمنطقة الزمنية</label>
        <input type="text" class="fc" id="my-country" placeholder="مثال: المغرب (GMT+1)">
      </div>

      <div class="fg"><label class="fl">تخصصاتي الإضافية</label>
        <input type="text" class="fc" id="my-extra-specs" placeholder="مثال: الأطفال، مرضى التوحد، التعلم السريع...">
      </div>

      <div class="fg"><label class="fl">🕐 أيام التدريس المتاحة</label>
        <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:.3rem">
          <label style="display:flex;flex-direction:column;align-items:center;gap:.2rem;cursor:pointer"><input type="checkbox" id="av-0" style="accent-color:var(--go)"><span style="font-size:.62rem">الأح</span></label>
          <label style="display:flex;flex-direction:column;align-items:center;gap:.2rem;cursor:pointer"><input type="checkbox" id="av-1" checked style="accent-color:var(--go)"><span style="font-size:.62rem">الإث</span></label>
          <label style="display:flex;flex-direction:column;align-items:center;gap:.2rem;cursor:pointer"><input type="checkbox" id="av-2" checked style="accent-color:var(--go)"><span style="font-size:.62rem">الثل</span></label>
          <label style="display:flex;flex-direction:column;align-items:center;gap:.2rem;cursor:pointer"><input type="checkbox" id="av-3" checked style="accent-color:var(--go)"><span style="font-size:.62rem">الأر</span></label>
          <label style="display:flex;flex-direction:column;align-items:center;gap:.2rem;cursor:pointer"><input type="checkbox" id="av-4" checked style="accent-color:var(--go)"><span style="font-size:.62rem">الخم</span></label>
          <label style="display:flex;flex-direction:column;align-items:center;gap:.2rem;cursor:pointer"><input type="checkbox" id="av-5" style="accent-color:var(--go)"><span style="font-size:.62rem">الجم</span></label>
          <label style="display:flex;flex-direction:column;align-items:center;gap:.2rem;cursor:pointer"><input type="checkbox" id="av-6" style="accent-color:var(--go)"><span style="font-size:.62rem">السب</span></label>
        </div>
      </div>

      <div class="fg"><label class="fl">ساعات العمل اليومية</label>
        <div style="display:flex;gap:.5rem;align-items:center">
          <input type="time" class="fc" id="av-from" value="09:00" style="flex:1">
          <span style="color:var(--tm);font-size:.72rem">إلى</span>
          <input type="time" class="fc" id="av-to" value="21:00" style="flex:1">
        </div>
      </div>

      <div class="fg"><label class="fl">رابط شهاداتي أو موقعي</label>
        <input type="url" class="fc" id="my-website" placeholder="https://..." dir="ltr">
      </div>

      <button class="btn bgo bfw blg" onclick="saveMyProfile()">💾 حفظ الملف الشخصي</button>
    </div>
  </div>
  <div class="pg" id="p-certs">
