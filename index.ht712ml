    <!-- صورة الملف الشخصي -->
    <div style="padding:0 1rem .85rem">
      <div style="text-align:center;margin-bottom:.85rem">
        <div id="my-av-display" style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--go),var(--gl));display:flex;align-items:center;justify-content:center;font-size:1.8rem;font-weight:700;color:var(--navy);margin:0 auto .5rem;border:3px solid var(--go);overflow:hidden">م</div>
