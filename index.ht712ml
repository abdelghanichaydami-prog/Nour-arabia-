      <div style="font-size:.82rem;font-weight:700;color:var(--gl)" id="classroom-title">الفصل المباشر</div>
      <div style="font-size:.65rem;color:var(--grl);display:flex;align-items:center;gap:.3rem"><div style="width:7px;height:7px;background:var(--grl);border-radius:50%;animation:blink 1.5s infinite"></div>مباشر</div>
    </div>
    <div style="padding:0 1rem">
      <div class="lc-room">
        <div class="lc-room-inner">
          <div style="font-size:3rem;margin-bottom:.5rem">📹</div>
          <div style="font-size:.8rem;margin-bottom:.35rem">الفصل المباشر</div>
          <div style="font-size:.7rem;color:var(--td)">سيتم ربط Zoom / Google Meet قريباً</div>
          <button class="btn bgo bsm" style="margin-top:.85rem" onclick="joinZoom()">🔗 انضم عبر Zoom</button>
        </div>
      </div>
      <div class="lc-controls">
        <button class="lc-btn mic" id="lc-mic" onclick="toggleMic(this)" title="ميكروفون">🎙️</button>
        <button class="lc-btn cam" id="lc-cam" onclick="toggleCam(this)" title="كاميرا">📷</button>
        <button class="lc-btn share" onclick="shareScreen()" title="مشاركة الشاشة">🖥️</button>
        <button class="lc-btn end" onclick="endClass()" title="إنهاء">📵</button>
      </div>
      <div style="font-size:.78rem;font-weight:700;margin-bottom:.4rem">💬 الدردشة</div>
      <div class="lc-chat" id="lc-chat">
        <div class="lc-msg"><strong>النظام:</strong> مرحباً! الدرس جاهز. يمكنك التحدث مع معلمك هنا.</div>
      </div>
      <div class="lc-msg-input">
        <input type="text" class="fc" id="lc-msg-inp" placeholder="اكتب رسالة..." onkeydown="if(event.key==='Enter')sendLcMsg()">
        <button class="btn bgo bsm" onclick="sendLcMsg()">إرسال</button>
      </div>
    </div>
  </div>
  <div class="pg" id="p-rate">
