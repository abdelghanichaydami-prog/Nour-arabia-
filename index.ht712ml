          <button class="btn bgo" onclick="copyRefCode()">📋 نسخ الكود</button>
          <button class="btn bgr" onclick="shareRef()">📤 مشاركة واتساب</button>
        </div>
      </div>
      <div style="background:rgba(255,255,255,.03);border:1px solid var(--bdl);border-radius:14px;padding:1rem;margin-bottom:.85rem">
        <div style="font-size:.8rem;font-weight:700;color:var(--gl);margin-bottom:.65rem">📊 إحصائيات الإحالة</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem">
          <div style="text-align:center"><div style="font-size:1.5rem;font-weight:700;color:var(--gl)" id="ref-count">0</div><div style="font-size:.65rem;color:var(--tm)">صديق سجّل</div></div>
          <div style="text-align:center"><div style="font-size:1.5rem;font-weight:700;color:var(--grl)" id="ref-earned">$0</div><div style="font-size:.65rem;color:var(--tm)">رصيد مكتسب</div></div>
        </div>
      </div>
      <div style="font-size:.8rem;font-weight:700;color:var(--gl);margin-bottom:.55rem">📋 كيف يعمل؟</div>
      <div style="display:flex;flex-direction:column;gap:.45rem">
        <div style="display:flex;align-items:flex-start;gap:.65rem;background:rgba(255,255,255,.03);border:1px solid var(--bdl);border-radius:11px;padding:.7rem .85rem">
          <span style="font-size:1.3rem;flex-shrink:0">1️⃣</span>
          <div><div style="font-size:.78rem;font-weight:700">شارك كودك الخاص</div><div style="font-size:.65rem;color:var(--tm)">كل مستخدم لديه كود فريد خاص به</div></div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:.65rem;background:rgba(255,255,255,.03);border:1px solid var(--bdl);border-radius:11px;padding:.7rem .85rem">
          <span style="font-size:1.3rem;flex-shrink:0">2️⃣</span>
          <div><div style="font-size:.78rem;font-weight:700">صديقك يسجّل بالكود</div><div style="font-size:.65rem;color:var(--tm)">يدخل الكود عند التسجيل أو الدفع</div></div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:.65rem;background:rgba(255,255,255,.03);border:1px solid var(--bdl);border-radius:11px;padding:.7rem .85rem">
          <span style="font-size:1.3rem;flex-shrink:0">3️⃣</span>
          <div><div style="font-size:.78rem;font-weight:700">تحصلان على المكافأة</div><div style="font-size:.65rem;color:var(--tm)">$5 رصيد لك + $5 خصم له تلقائياً</div></div>
        </div>
      </div>
