<!DOCTYPE html>
<html lang="ar" dir="rtl" translate="no" class="notranslate">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg width='32' height='32' viewBox='0 0 32 32' xmlns='http://www.w3.org/2000/svg'%3E%3Crect width='32' height='32' rx='7' fill='%23070E1A'/%3E%3Cg transform='translate(16,17)'%3E%3Crect x='-6.5' y='8' width='13' height='4' rx='2' fill='%23C8963E' opacity='.85'/%3E%3Crect x='-5.5' y='5' width='11' height='4' rx='2' fill='%23C8963E' opacity='.9'/%3E%3Cpath d='M-5,5 L-3,-7 C-2,-8 2,-8 3,-7 L5,5 Z' fill='%23C8963E' opacity='.92'/%3E%3Crect x='-6' y='-9' width='12' height='3' rx='1.5' fill='%23C8963E'/%3E%3Crect x='-4' y='-12' width='8' height='4' rx='2' fill='%23C8963E'/%3E%3Cpath d='M-3.5,-12 L0,-18 L3.5,-12 Z' fill='%23C8963E'/%3E%3Ccircle cx='0' cy='-19' r='2' fill='%23F7DFA0'/%3E%3C/g%3E%3C/svg%3E">
<meta http-equiv="X-Content-Type-Options" content="nosniff">
<meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#071812" media="(prefers-color-scheme: dark)">
<meta name="color-scheme" content="dark">
<link rel="canonical" href="https://manarat-almaarifa.com/">
<link rel="manifest" href="./manifest.webmanifest">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="منارة المعرفة">
<meta name="description" content="منارة المعرفة — منصة تعليمية عالمية للدروس الخصوصية 1-على-1. تعلّم القرآن الكريم، واللغة العربية لغير الناطقين بها، والعلوم الشرعية، واللغات مع أفضل المعلمين، بلغتك وتوقيتك.">
<meta name="keywords" content="تعلم القرآن, تجويد, حفظ القرآن, إجازة بالسند, تعلم العربية لغير الناطقين بها, نحو وصرف, محادثة عربية, علوم شرعية, معلم قرآن أونلاين, دروس مباشرة">
<meta property="og:title" content="منارة المعرفة | منصة تعليمية عالمية شاملة">
<meta property="og:description" content="دروس خصوصية 1-على-1 مع معلمين متخصصين — قرآن، لغات، دعم دراسي، مهارات. درسك الأول مجاناً">
<meta property="og:url" content="https://manarat-almaarifa.com">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="منارة المعرفة | منصة تعليمية عالمية شاملة">
<meta name="twitter:description" content="دروس 1-على-1 مع معلمين متخصصين — قرآن، لغات، مواد دراسية، مهارات. درسك الأول مجاناً">
<title>منارة المعرفة | منصة تعليمية عالمية شاملة — النسخة النهائية المنقحة</title>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;font-family:"Cairo",sans-serif;background:#071812;color:#fff;direction:rtl;display:flex;flex-direction:column}
body{display:flex;flex-direction:column}
:root{--navy:#071812;--n2:#0F3D2E;--go:#D4AF6A;--gl:#F0D9A8;--gd:rgba(212,175,106,.12);--gr:#27ae60;--grl:#52d68a;--re:#c0392b;--pu:#8e44ad;--wh:#e8edf5;--tm:#8899aa;--td:#5A7A68;--bd:rgba(212,175,106,.22);--bdl:rgba(212,175,106,.10);--r:14px;--rl:20px;--rxl:28px;--sh:0 8px 32px rgba(0,0,0,.4);--nh:64px;--hh:56px;--emerald:#0F3D2E;--emerald-lt:#155C43;--gold-deep:#B8935A;--glow:rgba(212,175,106,.18)}
#app{flex:1 1 auto;min-height:0;height:100%;display:flex;flex-direction:column;overflow:hidden}
@media (min-width:760px){
  body{overflow:hidden}
  #app{width:100%;max-width:1280px;margin:0 auto;border-left:1px solid var(--bdl);border-right:1px solid var(--bdl)}
  header{padding-inline:1.5rem}
  .pg{padding-inline:clamp(1rem,3vw,2.25rem)}
  nav{left:50%;right:auto;transform:translateX(-50%);width:min(100%,1280px);border-left:1px solid var(--bdl);border-right:1px solid var(--bdl)}
  .hero{padding-inline:clamp(1rem,4vw,3rem)}
  .srchw{padding-inline:clamp(1rem,4vw,3rem)}
  .subj-grid{grid-template-columns:repeat(6,1fr)}
  .steps-wr{display:grid;grid-template-columns:repeat(3,1fr)}
  .crs-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;padding-inline:1rem}
}
@media (min-width:1100px){
  .subj-grid{grid-template-columns:repeat(6,1fr)}
  .crs-list{grid-template-columns:repeat(3,minmax(0,1fr))}
}

header{height:var(--hh);flex-shrink:0;background:rgba(7,24,18,.97);border-bottom:1px solid var(--bd);backdrop-filter:blur(20px);display:flex;align-items:center;padding:0 1rem;gap:.65rem;z-index:100}
.logo{width:38px;height:38px;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.lo-t{display:flex;flex-direction:column;justify-content:center;line-height:1.35;min-width:0;flex:1;overflow:hidden}
.lo-t .ar{font-family:"Amiri",serif;font-size:.82rem;color:var(--gl);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;line-height:1.4}.lo-t .en{font-size:.54rem;color:var(--tm);letter-spacing:.04em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;line-height:1.3}
.hm{flex:1}.live{display:inline-flex;align-items:center;gap:.3rem;background:rgba(39,174,96,.1);border:1px solid rgba(39,174,96,.25);border-radius:100px;padding:.18rem .55rem;font-size:.62rem;color:var(--grl);font-weight:600}
.ldot{width:5px;height:5px;background:var(--grl);border-radius:50%;animation:blink 1.5s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.hr{display:flex;align-items:center;gap:.45rem}
.ib{width:34px;height:34px;border-radius:8px;background:rgba(255,255,255,.05);border:1px solid var(--bd);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;color:var(--tm);position:relative}
.ib:hover{background:var(--gd);border-color:var(--go);color:var(--gl)}
.ndot{position:absolute;top:5px;right:5px;width:7px;height:7px;background:var(--re);border-radius:50%;border:1px solid var(--n2);display:none}
.uc{display:none;align-items:center;gap:.38rem;background:rgba(255,255,255,.05);border:1px solid var(--bd);border-radius:8px;padding:.25rem .6rem;cursor:pointer;transition:all .2s}
.uc:hover{border-color:var(--go)}.uc.on{display:flex}
.uav{width:22px;height:22px;border-radius:50%;background:linear-gradient(135deg,var(--go),var(--gl));display:flex;align-items:center;justify-content:center;font-size:.6rem;font-weight:700;color:var(--navy)}
.unm{font-size:.7rem;font-weight:600}
#cnt{flex:1 1 auto;min-height:0;overflow:hidden;position:relative}
.pg{position:absolute;inset:0;overflow-y:auto;overflow-x:hidden;padding-bottom:calc(var(--nh) + .5rem);opacity:0;pointer-events:none;transform:translateY(10px);transition:opacity .25s ease,transform .25s ease}
.pg.on{opacity:1;pointer-events:all;transform:translateY(0)}
.pg::-webkit-scrollbar{width:3px}.pg::-webkit-scrollbar-thumb{background:var(--go);border-radius:2px}
nav{position:fixed;bottom:0;left:0;right:0;height:var(--nh);background:rgba(7,24,18,.98);border-top:1px solid var(--bd);backdrop-filter:blur(24px);display:flex;align-items:stretch;z-index:500}
.ni{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.16rem;cursor:pointer;color:var(--td);transition:all .22s;position:relative;padding:.3rem 0;border:none;background:none;font-family:"Cairo",sans-serif}
.ni::before{content:"";position:absolute;top:0;left:22%;right:22%;height:2px;background:linear-gradient(90deg,var(--go),var(--gl));border-radius:0 0 2px 2px;opacity:0;transition:opacity .22s}
.ni.on{color:var(--gl)}.ni.on::before{opacity:1}
.ni-ic{width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center;transition:all .22s}.ni.on .ni-ic{background:rgba(212,175,106,.12)}
.ni-lb{font-size:.54rem;font-weight:700}
.btn{display:inline-flex;align-items:center;gap:.35rem;padding:.52rem 1.1rem;border-radius:10px;font-family:"Cairo",sans-serif;font-size:.8rem;font-weight:700;cursor:pointer;transition:all .2s;border:none;text-decoration:none;white-space:nowrap;justify-content:center}
.bgo{background:linear-gradient(135deg,var(--go),var(--gl));color:var(--navy)}.bgo:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(212,175,106,.4)}
.bgr{background:#25d366;color:#fff}.bgh{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:var(--tm)}.bgh:hover{border-color:var(--go);color:var(--gl)}
.bsm{padding:.35rem .8rem;font-size:.72rem}.blg{padding:.72rem 1.7rem;font-size:.9rem}.bfw{width:100%}
.fg{margin-bottom:.82rem}.fl{font-size:.72rem;font-weight:700;color:var(--gl);display:block;margin-bottom:.3rem}
.fc{width:100%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:.6rem .88rem;color:#fff;font-family:"Cairo",sans-serif;font-size:.82rem;direction:rtl;transition:border-color .2s}
.fc:focus{outline:none;border-color:var(--go)}.fc option{background:var(--n2)}.f2{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}
#tc{position:fixed;top:calc(var(--hh) + .7rem);left:50%;transform:translateX(-50%);z-index:9999;display:flex;flex-direction:column;gap:.4rem;align-items:center;width:min(92vw,360px);pointer-events:none}
.toast{border-radius:11px;padding:.62rem 1rem;font-size:.78rem;font-weight:600;display:flex;align-items:center;gap:.48rem;pointer-events:all;font-family:"Cairo",sans-serif;animation:tin .28s ease;direction:rtl;box-shadow:var(--sh)}
.ts{background:rgba(39,174,96,.15);border:1px solid rgba(39,174,96,.35);color:var(--grl)}.te{background:rgba(192,57,43,.15);border:1px solid rgba(192,57,43,.35);color:#e74c3c}.ti{background:rgba(212,175,106,.1);border:1px solid rgba(212,175,106,.3);color:var(--gl)}
@keyframes tin{from{opacity:0;transform:translateY(-12px)}to{opacity:1;transform:translateY(0)}}@keyframes tout{to{opacity:0;transform:translateY(-12px)}}
.mo{position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:500;display:none;align-items:flex-end;backdrop-filter:blur(6px)}.mo.on{display:flex}
.md{background:var(--n2);border-radius:var(--rxl) var(--rxl) 0 0;border-top:1px solid var(--bd);width:100%;max-height:90vh;overflow-y:auto;animation:su .3s cubic-bezier(.4,0,.2,1);padding-bottom:2rem}
.md::-webkit-scrollbar{width:3px}.md::-webkit-scrollbar-thumb{background:var(--go);border-radius:2px}
@keyframes su{from{transform:translateY(100%)}to{transform:translateY(0)}}
.mhd{width:38px;height:4px;background:rgba(255,255,255,.14);border-radius:2px;margin:.85rem auto .55rem}
.mtt{font-size:1.05rem;font-weight:700;padding:.45rem 1.2rem .85rem;border-bottom:1px solid var(--bdl)}.mbd{padding:1.1rem}
.shr{padding:.9rem 1rem .55rem;display:flex;align-items:center;justify-content:space-between}
.sht{font-size:.9rem;font-weight:700}.sht em{color:var(--gl);font-style:normal}.slk{font-size:.7rem;color:var(--go);cursor:pointer}.slk:hover{text-decoration:underline}
.pill{display:inline-block;padding:.1rem .48rem;border-radius:100px;font-size:.64rem;font-weight:700}
.pgg{background:rgba(39,174,96,.15);color:var(--grl)}.pgo{background:rgba(212,175,106,.15);color:var(--gl)}.pgb{background:rgba(52,152,219,.15);color:#5dade2}.pgr{background:rgba(192,57,43,.15);color:#e74c3c}
.tgl{width:40px;height:22px;background:rgba(255,255,255,.1);border-radius:100px;position:relative;cursor:pointer;transition:background .3s;flex-shrink:0}
.tgl.on{background:var(--gr)}.tgl::after{content:"";width:16px;height:16px;background:#fff;border-radius:50%;position:absolute;top:3px;right:3px;transition:transform .3s}.tgl.on::after{transform:translateX(-18px)}
.prg-i{margin-bottom:.82rem}.prg-h{display:flex;justify-content:space-between;font-size:.76rem;margin-bottom:.3rem}.prg-p{color:var(--gl);font-weight:700}
.prg-b{height:7px;background:rgba(255,255,255,.07);border-radius:100px;overflow:hidden}
.prg-f{height:100%;border-radius:100px;background:linear-gradient(90deg,var(--go),var(--gl));transition:width 1s ease}.prg-f.gn{background:linear-gradient(90deg,var(--gr),var(--grl))}
@keyframes fu{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.dt{width:100%;border-collapse:collapse;font-size:.75rem}
.dt th{background:rgba(255,255,255,.04);padding:.52rem .7rem;text-align:right;font-size:.65rem;color:var(--tm);font-weight:700;text-transform:uppercase;border-bottom:1px solid rgba(255,255,255,.06)}
.dt td{padding:.58rem .7rem;border-bottom:1px solid rgba(255,255,255,.04);color:var(--wh);vertical-align:middle}
.dt tr:hover td{background:rgba(255,255,255,.02)}
.ab{padding:.2rem .5rem;border-radius:6px;font-size:.65rem;font-weight:700;border:none;cursor:pointer;font-family:"Cairo",sans-serif;margin-left:.2rem;transition:all .2s}
.abg{background:rgba(39,174,96,.12);color:var(--grl)}.abg:hover{background:rgba(39,174,96,.22)}.abr{background:rgba(192,57,43,.12);color:#e74c3c}.abr:hover{background:rgba(192,57,43,.22)}.abo{background:var(--gd);color:var(--gl)}.abo:hover{background:rgba(212,175,106,.2)}
/* ══════════ HOME — WORLD-CLASS REBUILD ══════════ */
#p-home{background:var(--navy)}

/* HERO */
.hero{position:relative;padding:1.6rem 1rem 0;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 120% 80% at 50% 0%,rgba(212,175,106,.11),transparent 65%),radial-gradient(ellipse 60% 40% at 80% 25%,rgba(39,174,96,.06),transparent 50%);pointer-events:none}
.h-badge{display:inline-flex;align-items:center;gap:.35rem;background:rgba(212,175,106,.1);border:1px solid rgba(212,175,106,.28);border-radius:100px;padding:.25rem .75rem;font-size:.62rem;font-weight:700;color:var(--gl);margin-bottom:.75rem;animation:fdin .6s ease}
.h-badge::before{content:'';width:5px;height:5px;background:var(--grl);border-radius:50%;animation:blink 1.5s infinite}
@keyframes fdin{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}
.htt{font-family:"Amiri",serif;font-size:clamp(1.9rem,6vw,2.9rem);line-height:1.22;margin-bottom:.5rem;background:linear-gradient(150deg,#fff 20%,var(--gl) 60%,#fff 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:fdin .6s .1s both}
.hsb{font-size:.8rem;color:var(--tm);line-height:1.75;max-width:300px;margin:0 auto .95rem;animation:fdin .6s .2s both}

/* SEARCH BAR — like italki/Preply */
.srchw{padding:0 1rem .9rem;animation:fdin .6s .3s both}
.srch{display:flex;background:rgba(255,255,255,.07);border:1.5px solid rgba(212,175,106,.3);border-radius:14px;overflow:hidden;transition:border-color .2s}
.srch:focus-within{border-color:var(--go);background:rgba(255,255,255,.09)}
.srch input{flex:1;background:none;border:none;padding:.72rem .9rem;color:#fff;font-family:"Cairo",sans-serif;font-size:.82rem;direction:rtl}
.srch input:focus{outline:none}
.srch input::placeholder{color:var(--td)}
.srch-btn{background:linear-gradient(135deg,var(--go),var(--gl));border:none;padding:.5rem .9rem;cursor:pointer;color:var(--navy);font-size:.85rem;display:flex;align-items:center;transition:opacity .2s}
.srch-btn:hover{opacity:.9}
.srch-tags{display:flex;gap:.38rem;flex-wrap:wrap;margin-top:.5rem}
.srch-tag{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);border-radius:100px;padding:.2rem .6rem;font-size:.64rem;color:var(--tm);cursor:pointer;transition:all .18s}
.srch-tag:hover{border-color:var(--go);color:var(--gl);background:var(--gd)}

/* STATS TICKER */
.ticker{background:rgba(255,255,255,.025);border-top:1px solid var(--bdl);border-bottom:1px solid var(--bdl);padding:.6rem 0;overflow:hidden;position:relative}
.ticker-inner{display:flex;gap:2rem;white-space:nowrap;animation:scroll 22s linear infinite}
@keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.ticker-item{display:inline-flex;align-items:center;gap:.45rem;font-size:.68rem;color:var(--tm);flex-shrink:0}
.ticker-item strong{color:var(--gl)}

/* SUBJECTS — like Preply categories */
.sec-hd{display:flex;align-items:center;justify-content:space-between;padding:.95rem 1rem .55rem}
.sec-ht{font-size:.88rem;font-weight:700}.sec-ht em{color:var(--gl);font-style:normal}
.sec-lk{font-size:.68rem;color:var(--go);cursor:pointer;display:flex;align-items:center;gap:.2rem}
.sec-lk:hover{text-decoration:underline}
.subj-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.55rem;padding:0 1rem .9rem}
.subj{border-radius:var(--rl);overflow:hidden;border:1.5px solid;cursor:pointer;transition:all .25s;position:relative}
.subj:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(0,0,0,.35)}
.subj.q{background:linear-gradient(145deg,rgba(39,174,96,.1),rgba(39,174,96,.04));border-color:rgba(39,174,96,.22)}
.subj.l{background:linear-gradient(145deg,rgba(212,175,106,.1),rgba(212,175,106,.04));border-color:rgba(212,175,106,.22)}
.subj.s{background:linear-gradient(145deg,rgba(142,68,173,.1),rgba(142,68,173,.04));border-color:rgba(142,68,173,.22)}
.subj-ic{font-size:1.7rem;display:block;padding:.85rem .7rem .35rem;text-align:center}
.subj-nm{font-size:.7rem;font-weight:700;text-align:center;padding:0 .5rem;margin-bottom:.22rem}
.q .subj-nm{color:#52d68a}.l .subj-nm{color:var(--gl)}.s .subj-nm{color:#c39bd3}
.subj-ss{font-size:.58rem;color:var(--tm);text-align:center;padding:0 .5rem .75rem;line-height:1.4}
.subj-bd{position:absolute;top:.42rem;left:.42rem;font-size:.53rem;font-weight:700;padding:.1rem .35rem;border-radius:100px}
.q .subj-bd{background:rgba(39,174,96,.2);color:#52d68a}.l .subj-bd{background:rgba(212,175,106,.2);color:var(--gl)}.s .subj-bd{background:rgba(142,68,173,.2);color:#c39bd3}

/* HOW IT WORKS — 3 steps like Preply */
.steps{padding:0 1rem 1rem}
.steps-wr{display:flex;flex-direction:column;gap:.52rem}
.step{display:flex;align-items:flex-start;gap:.75rem;background:rgba(255,255,255,.025);border:1px solid var(--bdl);border-radius:var(--r);padding:.82rem .88rem;transition:border-color .22s}
.step:hover{border-color:rgba(212,175,106,.28)}
.step-num{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--go),var(--gl));display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;color:var(--navy);flex-shrink:0;font-family:"Amiri",serif}
.step-t{font-size:.8rem;font-weight:700;margin-bottom:.18rem}
.step-d{font-size:.7rem;color:var(--tm);line-height:1.55}

/* TEACHERS — like italki teacher cards */
.tsc{display:flex;gap:.65rem;padding:0 1rem .9rem;overflow-x:auto;scrollbar-width:none}
.tsc::-webkit-scrollbar{display:none}
.tmc{flex-shrink:0;width:155px;background:rgba(255,255,255,.035);border:1px solid var(--bdl);border-radius:var(--rl);padding:1rem .8rem;cursor:pointer;transition:all .25s;position:relative}
.tmc:hover{border-color:var(--go);transform:translateY(-3px);box-shadow:0 10px 28px rgba(0,0,0,.3)}
.tmc-badge{position:absolute;top:.6rem;left:.6rem;font-size:.52rem;font-weight:700;padding:.12rem .4rem;border-radius:100px;background:rgba(212,175,106,.2);color:var(--gl)}
.tav{width:52px;height:52px;border-radius:50%;margin:0 auto .55rem;display:flex;align-items:center;justify-content:center;font-family:"Amiri",serif;font-size:1.2rem;font-weight:700;border:2.5px solid rgba(212,175,106,.25);position:relative}
.tav::after{content:'';position:absolute;bottom:1px;right:1px;width:10px;height:10px;background:#25d366;border-radius:50%;border:2px solid var(--navy)}
.tnm{font-size:.77rem;font-weight:700;margin-bottom:.12rem;text-align:center}
.tsp{font-size:.6rem;color:var(--tm);margin-bottom:.35rem;text-align:center;line-height:1.4}
.trt{font-size:.68rem;color:var(--go);text-align:center;margin-bottom:.28rem}
.tlangs{display:flex;justify-content:center;gap:.22rem;flex-wrap:wrap;margin-bottom:.55rem}
.tlg{font-size:.52rem;background:rgba(255,255,255,.07);border-radius:4px;padding:.08rem .3rem;color:var(--tm)}
.tprc{font-size:.72rem;font-weight:700;color:var(--gl);text-align:center;margin-bottom:.52rem}
.tmc .btn{width:100%;font-size:.67rem;padding:.38rem}

/* COURSES — like Udemy cards */
.crs-list{display:flex;flex-direction:column;gap:.55rem;padding:0 1rem .5rem}
.crs-tabs{display:flex;gap:.35rem;padding:0 1rem .6rem;overflow-x:auto;scrollbar-width:none}
.crs-tabs::-webkit-scrollbar{display:none}
.crs-tab{flex-shrink:0;padding:.33rem .72rem;border-radius:100px;font-size:.67rem;font-weight:700;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.04);color:var(--tm);cursor:pointer;transition:all .2s;font-family:"Cairo",sans-serif}
.crs-tab.on{background:var(--go);border-color:var(--go);color:var(--navy)}
.crs-card{background:rgba(255,255,255,.03);border:1px solid var(--bdl);border-radius:var(--rl);overflow:hidden;cursor:pointer;transition:all .22s;display:flex;gap:0}
.crs-card:hover{border-color:rgba(212,175,106,.35);transform:translateX(-2px)}
.crs-thumb{width:72px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:2rem}
.crs-thumb.q{background:rgba(39,174,96,.08)}.crs-thumb.l{background:rgba(212,175,106,.08)}.crs-thumb.s{background:rgba(142,68,173,.08)}
.crs-body{flex:1;padding:.7rem .82rem .7rem .5rem;min-width:0}
.crs-cat{font-size:.57rem;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:.2rem}
.q .crs-cat{color:#52d68a}.l .crs-cat{color:var(--gl)}.s .crs-cat{color:#c39bd3}
.crs-t{font-size:.82rem;font-weight:700;margin-bottom:.2rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.crs-inf{display:flex;align-items:center;gap:.55rem;font-size:.62rem;color:var(--tm);margin-bottom:.3rem}
.crs-stars{color:var(--go);letter-spacing:-.5px}
.crs-price{display:flex;align-items:center;gap:.38rem}
.crs-new{font-size:.88rem;font-weight:700;color:var(--gl)}
.crs-old{font-size:.7rem;color:var(--td);text-decoration:line-through}
.crs-off{font-size:.6rem;background:rgba(39,174,96,.12);color:var(--grl);padding:.08rem .35rem;border-radius:4px;font-weight:700}
.crs-card.hide{display:none}

/* TESTIMONIALS — with flags */
.testi-scroll{display:flex;gap:.65rem;padding:0 1rem 1rem;overflow-x:auto;scrollbar-width:none}
.testi-scroll::-webkit-scrollbar{display:none}
.testi{flex-shrink:0;width:230px;background:rgba(255,255,255,.03);border:1px solid var(--bdl);border-radius:var(--rl);padding:1rem;cursor:default;transition:border-color .2s}
.testi:hover{border-color:rgba(212,175,106,.25)}
.testi-q{font-size:2.2rem;color:var(--go);opacity:.25;line-height:1;margin-bottom:.3rem;font-family:"Amiri",serif}
.testi-txt{font-size:.74rem;color:var(--wh);line-height:1.65;margin-bottom:.72rem;font-style:italic}
.testi-auth{display:flex;align-items:center;gap:.55rem}
.testi-av{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--go),var(--gl));display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;color:var(--navy);flex-shrink:0}
.testi-nm{font-size:.74rem;font-weight:700}
.testi-co{font-size:.6rem;color:var(--tm)}
.testi-rt{font-size:.68rem;color:var(--go);margin-top:.1rem}

/* PRICING — like Preply plans */
.prc-grid{display:flex;gap:.6rem;padding:0 1rem 1rem;overflow-x:auto;scrollbar-width:none}
.prc-grid::-webkit-scrollbar{display:none}
.prc-c{flex-shrink:0;width:165px;background:rgba(255,255,255,.03);border:1.5px solid var(--bdl);border-radius:var(--rl);padding:.95rem .82rem;position:relative;transition:all .25s;cursor:pointer}
.prc-c:hover{transform:translateY(-3px)}
.prc-c.best{border-color:rgba(212,175,106,.5);background:rgba(212,175,106,.07)}
.prc-best-tag{position:absolute;top:-.65rem;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--go),var(--gl));color:var(--navy);font-size:.55rem;font-weight:700;padding:.15rem .6rem;border-radius:100px;white-space:nowrap}
.prc-nm{font-size:.8rem;font-weight:700;margin-bottom:.48rem}
.prc-pr{font-family:"Amiri",serif;font-size:2rem;font-weight:700;color:var(--gl);line-height:1}
.prc-per{font-size:.6rem;color:var(--tm);margin-bottom:.65rem}
.prc-feats{display:flex;flex-direction:column;gap:.28rem;margin-bottom:.75rem}
.prc-feat{font-size:.66rem;color:var(--wh);display:flex;align-items:center;gap:.3rem}
.prc-feat::before{content:"✓";color:var(--go);font-weight:700;flex-shrink:0;font-size:.72rem}
.prc-split{font-size:.6rem;color:var(--td);background:rgba(255,255,255,.04);border-radius:6px;padding:.22rem .45rem;text-align:center;margin-bottom:.6rem}
.prc-c .btn{width:100%;font-size:.7rem;padding:.42rem}

/* FAQ */
.faq-wr{display:flex;flex-direction:column;gap:.48rem;padding:0 1rem 1rem}
.faq-i{background:rgba(255,255,255,.025);border:1px solid var(--bdl);border-radius:var(--r);overflow:hidden;cursor:pointer;transition:border-color .2s}
.faq-i.on{border-color:rgba(212,175,106,.3)}
.faq-q{display:flex;align-items:center;justify-content:space-between;padding:.82rem .9rem;font-size:.8rem;font-weight:600;gap:.55rem;transition:color .2s}
.faq-i.on .faq-q{color:var(--gl)}
.faq-ic{font-size:.65rem;color:var(--go);transition:transform .28s;flex-shrink:0}
.faq-i.on .faq-ic{transform:rotate(180deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .32s ease,padding .25s;font-size:.76rem;color:var(--tm);line-height:1.7;padding:0 .9rem}
.faq-i.on .faq-a{max-height:200px;padding:0 .9rem .82rem}

/* TRUST STRIP */
.trust-strip{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;padding:0 1rem 1rem}
.trust-item{background:rgba(255,255,255,.03);border:1px solid var(--bdl);border-radius:var(--r);padding:.72rem .8rem;display:flex;align-items:center;gap:.55rem}
.trust-ic{font-size:1.3rem;flex-shrink:0}
.trust-t{font-size:.72rem;font-weight:700}
.trust-d{font-size:.6rem;color:var(--tm)}

/* CTA BANNER */
.cta-banner{margin:0 1rem 1rem;background:linear-gradient(135deg,rgba(212,175,106,.15),rgba(212,175,106,.06));border:1px solid rgba(212,175,106,.3);border-radius:var(--rl);padding:1.2rem 1rem;text-align:center}
.cta-banner h3{font-family:"Amiri",serif;font-size:1.2rem;margin-bottom:.38rem}
.cta-banner p{font-size:.74rem;color:var(--tm);margin-bottom:.85rem;line-height:1.6}
.cta-banner .btn{display:inline-flex}

/* FOOTER */
.home-footer{background:rgba(0,0,0,.35);border-top:1px solid var(--bdl);padding:1.2rem 1rem 1rem;margin-top:.5rem}
.footer-brand{display:flex;align-items:center;gap:.6rem;margin-bottom:.65rem}
.footer-desc{font-size:.7rem;color:var(--tm);line-height:1.6;margin-bottom:.85rem}
.footer-links{display:grid;grid-template-columns:1fr 1fr;gap:.35rem .9rem;margin-bottom:.85rem}
.footer-links a{font-size:.7rem;color:var(--td);text-decoration:none;transition:color .2s;display:flex;align-items:center;gap:.3rem}
.footer-links a:hover{color:var(--gl)}
.footer-social{display:flex;gap:.48rem;margin-bottom:.8rem}
.fsoc{width:30px;height:30px;border-radius:8px;background:rgba(255,255,255,.05);border:1px solid var(--bdl);display:flex;align-items:center;justify-content:center;font-size:.78rem;cursor:pointer;transition:all .2s;text-decoration:none}
.fsoc:hover{border-color:var(--go);background:var(--gd)}
.footer-copy{font-size:.62rem;color:var(--td);text-align:center;border-top:1px solid rgba(255,255,255,.04);padding-top:.72rem}
/* other */
.sts{display:none}
.hsc{display:none}
.tav{width:52px;height:52px;border-radius:50%;margin:0 auto .55rem;display:flex;align-items:center;justify-content:center;font-family:"Amiri",serif;font-size:1.2rem;font-weight:700;border:2.5px solid rgba(212,175,106,.25)}
/* LANG CARDS */
.lang-card{background:rgba(255,255,255,.03);border:1px solid rgba(52,152,219,.15);border-radius:12px;padding:.75rem;cursor:pointer;transition:all .2s;text-align:center}
.lang-card:hover,.lang-card:active{border-color:rgba(52,152,219,.45);transform:translateY(-2px)}
.lang-flag{font-size:1.5rem;margin-bottom:.22rem}
.lang-nm{font-size:.78rem;font-weight:700}
.lang-en{font-size:.62rem;color:var(--tm)}
.lang-lv{font-size:.58rem;background:rgba(52,152,219,.1);color:#5dade2;padding:.1rem .35rem;border-radius:100px;display:inline-block;margin-top:.22rem}
/* SUBJ CARDS */
.subj-card{background:rgba(255,255,255,.03);border:1px solid rgba(142,68,173,.15);border-radius:12px;padding:.7rem;cursor:pointer;transition:all .2s;text-align:center}
.subj-card:hover,.subj-card:active{border-color:rgba(142,68,173,.45);transform:translateY(-2px)}
.subj-ic{font-size:1.4rem;display:block;margin-bottom:.18rem}
.subj-nm{font-size:.76rem;font-weight:700}
.subj-lv{font-size:.6rem;color:var(--tm)}
/* EXAM CARDS */
.exam-card{background:rgba(255,255,255,.03);border:1px solid rgba(142,68,173,.12);border-radius:11px;padding:.7rem .85rem;display:flex;align-items:center;gap:.65rem;cursor:pointer;transition:border-color .2s}
.exam-card:hover,.exam-card:active{border-color:rgba(142,68,173,.4)}
.exam-ic{font-size:1.5rem;flex-shrink:0}
.exam-nm{font-size:.78rem;font-weight:700}
.exam-ds{font-size:.66rem;color:var(--tm)}
/* SKILL CARDS */
.skill-card{background:rgba(255,255,255,.03);border:1px solid rgba(39,174,96,.12);border-radius:12px;padding:.75rem;cursor:pointer;transition:all .2s;text-align:center}
.skill-card:hover,.skill-card:active{border-color:rgba(39,174,96,.45);transform:translateY(-2px)}
.skill-ic{font-size:1.5rem;margin-bottom:.18rem}
.skill-nm{font-size:.78rem;font-weight:700}
.skill-sub{font-size:.6rem;color:var(--tm)}
/* LANG CHECK */
.lang-check{display:flex;align-items:center;gap:.3rem;background:rgba(255,255,255,.03);border:1px solid var(--bdl);border-radius:8px;padding:.35rem .5rem;cursor:pointer;font-size:.68rem}
/* HALLS */
#p-halls{background:var(--navy)}
.hahd{padding:.85rem 1rem .52rem;background:linear-gradient(180deg,rgba(15,61,46,.92),rgba(7,24,18,.75));position:sticky;top:0;z-index:10;backdrop-filter:blur(12px)}
.htbs{display:flex;gap:.38rem;background:rgba(255,255,255,.04);border:1px solid var(--bdl);border-radius:11px;padding:.3rem}
.htb{flex:1;padding:.46rem;border-radius:8px;font-family:"Cairo",sans-serif;font-size:.7rem;font-weight:700;cursor:pointer;border:none;background:transparent;color:var(--tm);transition:all .2s;display:flex;flex-direction:column;align-items:center;gap:.13rem}
.htb em{font-size:.88rem;font-style:normal}.htb.on{background:rgba(255,255,255,.08);color:#fff}
.htb.q.on{background:rgba(39,174,96,.15);color:#52d68a}.htb.l.on{background:rgba(212,175,106,.15);color:var(--gl)}.htb.s.on{background:rgba(142,68,173,.15);color:#c39bd3}
.hcn{display:none;padding:0 1rem .85rem;animation:fu .22s ease}.hcn.on{display:block}
.hib{border-radius:var(--rl);overflow:hidden;border:1px solid;margin-bottom:.72rem}
.q .hib{border-color:rgba(39,174,96,.2)}.l .hib{border-color:rgba(212,175,106,.2)}.s .hib{border-color:rgba(142,68,173,.2)}
.hibh{padding:1.05rem;display:flex;gap:.72rem;align-items:flex-start}
.q .hibh{background:rgba(39,174,96,.06)}.l .hibh{background:rgba(212,175,106,.06)}.s .hibh{background:rgba(142,68,173,.06)}
.hibic{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.35rem;flex-shrink:0}
.q .hibic{background:rgba(39,174,96,.15)}.l .hibic{background:rgba(212,175,106,.15)}.s .hibic{background:rgba(142,68,173,.15)}
.hibtt{font-family:"Amiri",serif;font-size:1.05rem;font-weight:700;margin-bottom:.18rem}
.q .hibtt{color:#52d68a}.l .hibtt{color:var(--gl)}.s .hibtt{color:#c39bd3}
.hibds{font-size:.7rem;color:var(--tm);line-height:1.6;margin-bottom:.48rem}
.hibst{display:flex;gap:1rem}.hibsn{font-size:.97rem;font-weight:900;font-family:"Amiri",serif}
.q .hibsn{color:#52d68a}.l .hibsn{color:var(--gl)}.s .hibsn{color:#c39bd3}
.hibsl{font-size:.57rem;color:var(--tm)}
.secl{display:flex;flex-direction:column;gap:.48rem;margin-bottom:.72rem}
.sei{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);border-radius:var(--r);padding:.75rem .88rem;display:flex;align-items:center;gap:.72rem;cursor:pointer;transition:all .2s}
.sei:hover{border-color:var(--bd);background:rgba(255,255,255,.07)}
.seic{font-size:1.2rem;flex-shrink:0}.seif{flex:1;min-width:0}.senm{font-size:.79rem;font-weight:700;margin-bottom:.14rem}.semt{font-size:.62rem;color:var(--tm)}
.sebd{font-size:.57rem;font-weight:700;padding:.1rem .36rem;border-radius:100px;flex-shrink:0}
.q .sebd{background:rgba(39,174,96,.15);color:#52d68a}.l .sebd{background:rgba(212,175,106,.15);color:var(--gl)}.s .sebd{background:rgba(142,68,173,.15);color:#c39bd3}
.sear{color:var(--td);font-size:.78rem;flex-shrink:0}
.aadd{display:none;align-items:center;gap:.42rem;background:rgba(255,255,255,.03);border:1px dashed rgba(255,255,255,.1);border-radius:var(--r);padding:.58rem .8rem;margin-bottom:.72rem}
body.adm .aadd{display:flex}
.ainp{flex:1;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:.38rem .62rem;color:#fff;font-family:"Cairo",sans-serif;font-size:.75rem;direction:rtl}
.ainp:focus{outline:none;border-color:var(--go)}
.hac{display:flex;gap:.48rem;margin-top:.5rem}.hac .btn{flex:1;font-size:.7rem;padding:.45rem .38rem}
/* BOOK */
#p-book{background:var(--n2)}
.bkst{display:flex;gap:.3rem;padding:.88rem 1rem .42rem;overflow-x:auto;scrollbar-width:none}.bkst::-webkit-scrollbar{display:none}
.bks{flex-shrink:0;display:flex;align-items:center;gap:.38rem;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:9px;padding:.45rem .65rem;opacity:.42;transition:all .28s}
.bks.done{opacity:1;border-color:rgba(39,174,96,.3);background:rgba(39,174,96,.06)}.bks.on{opacity:1;border-color:var(--go);background:var(--gd)}
.snum{width:19px;height:19px;border-radius:50%;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-size:.62rem;font-weight:700;flex-shrink:0}
.bks.done .snum{background:var(--gr);color:#fff}.bks.on .snum{background:var(--go);color:var(--navy)}
.stxt{font-size:.67rem;font-weight:600;white-space:nowrap}
.bkp{display:none;padding:.62rem 1rem 1rem;animation:fu .22s ease}.bkp.on{display:block}
.calw{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:var(--rl);overflow:hidden;margin-bottom:.68rem}
.calh{display:flex;align-items:center;justify-content:space-between;padding:.62rem .92rem;background:rgba(255,255,255,.03);border-bottom:1px solid rgba(255,255,255,.06)}
.calt{font-size:.83rem;font-weight:700}.caln{background:none;border:none;color:var(--go);cursor:pointer;font-size:1rem;padding:.18rem .42rem;border-radius:6px;transition:background .2s}.caln:hover{background:var(--gd)}
.caldh{display:grid;grid-template-columns:repeat(7,1fr);border-bottom:1px solid rgba(255,255,255,.05)}
.cdhi{text-align:center;padding:.42rem 0;font-size:.58rem;font-weight:700;color:var(--tm)}
.calg{display:grid;grid-template-columns:repeat(7,1fr);padding:.3rem}
.cd{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:.7rem;border-radius:8px;cursor:pointer;transition:all .18s;font-weight:600;position:relative}
.cd:hover:not(.emp):not(.pa){background:var(--gd);color:var(--gl)}.cd.emp,.cd.pa{cursor:default}.cd.pa{color:var(--td);opacity:.35}
.cd.tod{border:1.5px solid var(--go);color:var(--gl)}.cd.sel{background:linear-gradient(135deg,var(--go),var(--gl));color:var(--navy);font-weight:900}
.cd.hss::after{content:"";width:4px;height:4px;background:var(--grl);border-radius:50%;position:absolute;bottom:3px;left:50%;transform:translateX(-50%)}
.slotg{display:grid;grid-template-columns:repeat(4,1fr);gap:.32rem;margin-bottom:.72rem}
.slot{background:rgba(255,255,255,.05);border:1.5px solid rgba(255,255,255,.1);border-radius:8px;padding:.42rem .28rem;font-size:.68rem;font-weight:700;text-align:center;cursor:pointer;transition:all .18s;color:var(--tm);font-family:"Cairo",sans-serif}
.slot:hover{border-color:var(--go);color:var(--gl);background:var(--gd)}.slot.on{background:linear-gradient(135deg,var(--go),var(--gl));border-color:transparent;color:var(--navy)}.slot.bk{opacity:.3;cursor:not-allowed;text-decoration:line-through}
.smcd{background:rgba(212,175,106,.07);border:1px solid rgba(212,175,106,.2);border-radius:var(--rl);padding:.95rem;margin-bottom:.72rem}
.smtt{font-size:.78rem;font-weight:700;color:var(--gl);margin-bottom:.62rem}
.smrw{display:flex;justify-content:space-between;padding:.33rem 0;border-bottom:1px solid rgba(255,255,255,.05);font-size:.75rem}.smrw:last-child{border:none}
.smto{display:flex;justify-content:space-between;margin-top:.5rem;padding-top:.5rem;border-top:1px solid var(--bd);font-size:.88rem;font-weight:700}
.payg{display:grid;grid-template-columns:1fr 1fr;gap:.42rem;margin-bottom:.72rem}
.paym{background:rgba(255,255,255,.04);border:1.5px solid rgba(255,255,255,.1);border-radius:10px;padding:.65rem;text-align:center;cursor:pointer;transition:all .2s;font-size:.7rem;font-weight:700;color:var(--tm)}
.paym:hover,.paym.on{border-color:var(--go);background:var(--gd);color:var(--gl)}.pmic{font-size:1.25rem;margin-bottom:.22rem;display:block}
/* DASH */
#p-dash{background:var(--navy)}
.dts{display:flex;gap:0;border-bottom:1px solid var(--bdl);margin:0 1rem}
.dta{flex:1;padding:.68rem .5rem;font-family:"Cairo",sans-serif;font-size:.72rem;font-weight:700;cursor:pointer;border:none;background:none;color:var(--tm);border-bottom:2px solid transparent;transition:all .2s}.dta.on{color:var(--gl);border-bottom-color:var(--go)}
.dpn{display:none;padding:1rem}.dpn.on{display:block;animation:fu .22s ease}
.dstt{display:grid;grid-template-columns:1fr 1fr;gap:.52rem;margin-bottom:.85rem}
.dst{border-radius:var(--r);padding:.88rem;text-align:center}.dst.go{background:rgba(212,175,106,.1);border:1px solid rgba(212,175,106,.18)}.dst.gn{background:rgba(39,174,96,.08);border:1px solid rgba(39,174,96,.15)}
.dsn{font-size:1.55rem;font-weight:900;font-family:"Amiri",serif;line-height:1}.dst.go .dsn{color:var(--gl)}.dst.gn .dsn{color:var(--grl)}.dsl{font-size:.6rem;color:var(--tm);margin-top:.16rem}
.lesc{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);border-radius:var(--r);padding:.8rem .9rem;display:flex;gap:.75rem;align-items:center;margin-bottom:.52rem;transition:all .2s;cursor:pointer}
.lesc:hover{border-color:var(--bd);background:rgba(255,255,255,.07)}
.lesd{width:40px;height:40px;border-radius:9px;background:rgba(212,175,106,.12);display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0}
.lesdy{font-size:1.05rem;font-weight:900;color:var(--gl);line-height:1}.lesmo{font-size:.53rem;color:var(--tm);text-transform:uppercase}
.lesinf{flex:1;min-width:0}.lesnm{font-size:.79rem;font-weight:700;margin-bottom:.13rem}.lesmt{font-size:.65rem;color:var(--tm)}
.etot{background:linear-gradient(135deg,rgba(212,175,106,.14),rgba(212,175,106,.05));border:1px solid rgba(212,175,106,.25);border-radius:var(--rl);padding:1.1rem;text-align:center;margin-bottom:.8rem}
.enum{font-size:2.1rem;font-weight:900;color:var(--gl);font-family:"Amiri",serif}.elbl{font-size:.7rem;color:var(--tm);margin-top:.16rem}
.txnr{display:flex;align-items:center;gap:.7rem;padding:.7rem 0;border-bottom:1px solid rgba(255,255,255,.05)}
.txic{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:.88rem;flex-shrink:0}.txic.in{background:rgba(39,174,96,.12)}.txic.out{background:rgba(192,57,43,.12)}
.txinf{flex:1;min-width:0}.txnm{font-size:.76rem;font-weight:700}.txdt{font-size:.63rem;color:var(--tm)}.txam{font-size:.85rem;font-weight:700}.txam.in{color:var(--grl)}.txam.out{color:#e74c3c}
/* ACCOUNT */
#p-acc{background:var(--n2)}
.achr{padding:1.4rem 1rem;text-align:center;background:linear-gradient(180deg,rgba(212,175,106,.07),transparent);border-bottom:1px solid var(--bdl);margin-bottom:.65rem}
.acav{width:70px;height:70px;border-radius:50%;margin:0 auto .75rem;background:linear-gradient(135deg,var(--go),var(--gl));display:flex;align-items:center;justify-content:center;font-family:"Amiri",serif;font-size:1.7rem;font-weight:700;color:var(--navy);border:3px solid rgba(212,175,106,.22);box-shadow:0 0 0 5px rgba(212,175,106,.07)}
.acnm{font-size:1.1rem;font-weight:700;margin-bottom:.15rem}.acro{font-size:.7rem;color:var(--gl);font-weight:600;margin-bottom:.6rem}
.acbd{display:inline-flex;align-items:center;gap:.32rem;background:var(--gd);border:1px solid var(--bd);border-radius:100px;padding:.22rem .75rem;font-size:.66rem;color:var(--gl);font-weight:600}
.mg{padding:0 1rem .45rem}.mgt{font-size:.62rem;color:var(--td);text-transform:uppercase;letter-spacing:1.5px;font-weight:700;margin-bottom:.4rem}
.mi{display:flex;align-items:center;gap:.78rem;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.05);border-radius:var(--r);padding:.85rem .9rem;margin-bottom:.4rem;cursor:pointer;transition:all .2s}
.mi:hover{background:rgba(255,255,255,.06);border-color:var(--bd)}
.miic{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:.95rem;flex-shrink:0}
.miic.go{background:rgba(212,175,106,.12)}.miic.gn{background:rgba(39,174,96,.1)}.miic.bl{background:rgba(52,152,219,.1)}.miic.re{background:rgba(192,57,43,.1)}.miic.pu{background:rgba(142,68,173,.1)}
.mitx{flex:1;min-width:0}.mitt{font-size:.8rem;font-weight:700;margin-bottom:.1rem}.mits{font-size:.63rem;color:var(--tm)}.miar{color:var(--td);font-size:.78rem}
.authf{padding:1rem;display:none}.authf.on{display:block}
.atbs{display:flex;border-bottom:1px solid var(--bdl);margin-bottom:1.1rem}
.atb{flex:1;padding:.68rem .5rem;text-align:center;font-family:"Cairo",sans-serif;font-size:.8rem;font-weight:700;cursor:pointer;border:none;background:none;color:var(--tm);border-bottom:2px solid transparent;transition:all .2s}.atb.on{color:var(--gl);border-bottom-color:var(--go)}
.apn{display:none}.apn.on{display:block;animation:fu .22s ease}
.socr{display:flex;gap:.52rem;margin-bottom:.8rem}
.socb{flex:1;display:flex;align-items:center;justify-content:center;gap:.42rem;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:.58rem;font-size:.76rem;font-weight:700;cursor:pointer;transition:all .2s;color:#fff;font-family:"Cairo",sans-serif}.socb:hover{border-color:var(--go)}
.divr{display:flex;align-items:center;gap:.7rem;margin-bottom:.8rem;color:var(--td);font-size:.68rem}.divr::before,.divr::after{content:"";flex:1;height:1px;background:rgba(255,255,255,.08)}
.pwd{position:relative}.pwd .fc{padding-left:2.6rem}.pwdt{position:absolute;left:.7rem;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--tm);cursor:pointer;font-size:.88rem}
/* ADMIN */
#p-adm{background:var(--n2);display:none}body.adm #p-adm{display:block}
.admts{display:flex;gap:.35rem;padding:.9rem 1rem .5rem;overflow-x:auto;scrollbar-width:none;border-bottom:1px solid var(--bdl)}.admts::-webkit-scrollbar{display:none}
.admt{flex-shrink:0;padding:.42rem .85rem;border-radius:8px;font-family:"Cairo",sans-serif;font-size:.7rem;font-weight:700;cursor:pointer;border:none;background:rgba(255,255,255,.04);color:var(--tm);transition:all .2s}.admt.on{background:linear-gradient(135deg,var(--go),var(--gl));color:var(--navy)}
.admp{display:none;padding:1rem}.admp.on{display:block;animation:fu .22s ease}
.admst{display:grid;grid-template-columns:repeat(2,1fr);gap:.55rem;margin-bottom:.9rem}
.ast{background:rgba(255,255,255,.04);border:1px solid var(--bdl);border-radius:var(--r);padding:.82rem;text-align:center}.astn{font-size:1.35rem;font-weight:900;color:var(--gl);font-family:"Amiri",serif}.astl{font-size:.6rem;color:var(--tm);margin-top:.1rem}
.logi{display:flex;gap:.6rem;align-items:flex-start;padding:.55rem 0;border-bottom:1px solid rgba(255,255,255,.04);font-size:.73rem}
.logd{width:7px;height:7px;border-radius:50%;flex-shrink:0;margin-top:.22rem}.logd.s{background:var(--grl)}.logd.w{background:var(--gl)}.logd.e{background:#e74c3c}
.logt{font-size:.6rem;color:var(--tm);margin-top:.1rem}
.setr{display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.05);border-radius:10px;padding:.82rem .95rem;margin-bottom:.45rem}
.setr h4{font-size:.8rem;font-weight:700;margin-bottom:.1rem}.setr p{font-size:.63rem;color:var(--tm)}
.chart{display:flex;align-items:flex-end;gap:.28rem;height:75px;margin:.65rem 0}
.chcl{display:flex;flex-direction:column;align-items:center;gap:.22rem;flex:1}.chbw{flex:1;display:flex;align-items:flex-end;width:100%}
.chb{width:100%;border-radius:4px 4px 0 0;min-height:3px;transition:height .6s ease}.chb.go{background:linear-gradient(180deg,var(--gl),rgba(212,175,106,.3))}
.chlb{font-size:.54rem;color:var(--tm);text-align:center}.chvl{font-size:.58rem;color:var(--gl);font-weight:700;text-align:center}
@media(min-width:769px){body{background:#030710;align-items:center;justify-content:center;height:100vh}#app{max-width:430px;height:90vh;border-radius:28px;overflow:hidden;box-shadow:0 0 80px rgba(0,0,0,.7)}}

/* ===PAGE: LIBRARY=== */
#p-lib{background:var(--navy)}
.lib-hd{padding:.88rem 1rem .52rem;background:linear-gradient(180deg,rgba(15,61,46,.92),rgba(7,24,18,.75));position:sticky;top:0;z-index:10;backdrop-filter:blur(16px) saturate(1.2);border-bottom:1px solid rgba(212,175,106,.12)}
.lib-search{display:flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.06);border:1px solid var(--bdl);border-radius:11px;padding:.45rem .75rem;margin-bottom:.6rem}
.lib-search svg{flex-shrink:0;color:var(--tm)}
.lib-search input{flex:1;background:none;border:none;color:#fff;font-family:"Cairo",sans-serif;font-size:.82rem;direction:rtl;outline:none}
.lib-search input::placeholder{color:var(--tm)}
.lib-cats{display:flex;gap:.38rem;overflow-x:auto;scrollbar-width:none;padding-bottom:.2rem}
.lib-cats::-webkit-scrollbar{display:none}
.lib-cat{flex-shrink:0;padding:.32rem .75rem;border-radius:100px;font-family:"Cairo",sans-serif;font-size:.68rem;font-weight:700;cursor:pointer;border:1.5px solid;transition:all .22s}
.lib-cat.on{color:var(--navy);border-color:transparent}
.lib-cat[data-c="all"]{border-color:var(--bd);color:var(--gl)}.lib-cat[data-c="all"].on{background:linear-gradient(135deg,var(--go),var(--gl))}
.lib-cat[data-c="q"]{border-color:rgba(39,174,96,.3);color:#52d68a}.lib-cat[data-c="q"].on{background:rgba(39,174,96,.8)}
.lib-cat[data-c="l"]{border-color:rgba(212,175,106,.3);color:var(--gl)}.lib-cat[data-c="l"].on{background:rgba(212,175,106,.8)}
.lib-cat[data-c="s"]{border-color:rgba(142,68,173,.3);color:#c39bd3}.lib-cat[data-c="s"].on{background:rgba(142,68,173,.8)}
.lib-cat[data-c="kids"]{border-color:rgba(52,152,219,.3);color:#5dade2}.lib-cat[data-c="kids"].on{background:rgba(52,152,219,.8)}
.lib-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;padding:.75rem 1rem 1rem}
.book-card{background:rgba(255,255,255,.04);border:1px solid var(--bdl);border-radius:var(--rl);overflow:hidden;cursor:pointer;transition:all .25s;position:relative}
.book-card:hover{border-color:var(--go);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.3)}
.book-cover{width:100%;aspect-ratio:3/4;display:flex;align-items:center;justify-content:center;font-size:2.8rem;position:relative;overflow:hidden}
.book-cover.q{background:linear-gradient(145deg,rgba(39,174,96,.2),rgba(39,174,96,.08))}
.book-cover.l{background:linear-gradient(145deg,rgba(212,175,106,.2),rgba(212,175,106,.08))}
.book-cover.s{background:linear-gradient(145deg,rgba(142,68,173,.2),rgba(142,68,173,.08))}
.book-cover.kids{background:linear-gradient(145deg,rgba(52,152,219,.2),rgba(52,152,219,.08))}
.book-cover img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
.book-badge{position:absolute;top:.5rem;right:.5rem;font-size:.55rem;font-weight:700;padding:.1rem .38rem;border-radius:100px}
.book-badge.free{background:rgba(39,174,96,.85);color:#fff}
.book-badge.new{background:rgba(212,175,106,.85);color:var(--navy)}
.book-badge.hot{background:rgba(192,57,43,.85);color:#fff}
.book-info{padding:.65rem .7rem .7rem}
.book-title{font-size:.78rem;font-weight:700;margin-bottom:.2rem;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.book-author{font-size:.62rem;color:var(--tm);margin-bottom:.45rem}
.book-footer{display:flex;align-items:center;justify-content:space-between}
.book-pages{font-size:.6rem;color:var(--tm)}
.book-btn{font-size:.65rem;font-weight:700;padding:.22rem .6rem;border-radius:7px;border:none;cursor:pointer;font-family:"Cairo",sans-serif;transition:all .2s}
.book-btn.read{background:linear-gradient(135deg,var(--go),var(--gl));color:var(--navy)}
.book-btn.lock{background:rgba(255,255,255,.07);color:var(--tm);border:1px solid rgba(255,255,255,.1)}
.lib-empty{text-align:center;padding:3rem 1rem;color:var(--tm)}
.lib-empty div{font-size:2.5rem;margin-bottom:.6rem}
/* PDF Viewer Modal */
#mo-pdf .md{border-radius:var(--rxl) var(--rxl) 0 0;max-height:95vh}
.pdf-hdr{display:flex;align-items:center;gap:.65rem;padding:.75rem 1rem;border-bottom:1px solid var(--bdl);position:sticky;top:0;background:var(--n2);z-index:10}
.pdf-title{flex:1;font-size:.82rem;font-weight:700;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pdf-actions{display:flex;gap:.38rem;flex-shrink:0}
.pdf-frame{width:100%;height:70vh;border:none;background:#fff}
.pdf-info-card{margin:1rem;background:rgba(255,255,255,.04);border:1px solid var(--bdl);border-radius:var(--r);padding:1rem}
.pdf-info-card .book-cover{border-radius:10px;width:80px;height:107px;font-size:2rem;flex-shrink:0}


/* ===PAGE: ABOUT=== */
#p-about{background:var(--navy)}
.about-hero{padding:2rem 1.2rem 1.5rem;text-align:center;background:linear-gradient(180deg,rgba(212,175,106,.08),transparent);border-bottom:1px solid var(--bdl)}
.about-bismillah{font-family:"Amiri",serif;font-size:1.6rem;color:var(--gl);margin-bottom:1rem;line-height:1.6}
.about-title{font-family:"Amiri",serif;font-size:1.5rem;font-weight:700;margin-bottom:.35rem;color:#fff}
.about-sub{font-size:.75rem;color:var(--tm);letter-spacing:1px;text-transform:uppercase;margin-bottom:1.2rem}
.about-divider{width:60px;height:3px;background:linear-gradient(90deg,var(--go),var(--gl));border-radius:2px;margin:0 auto 1.5rem}
.about-body{padding:1.2rem 1.2rem .5rem}
.about-p{font-family:"Amiri",serif;font-size:1.05rem;line-height:2;color:var(--wh);margin-bottom:1.2rem;text-align:justify}
.about-p em{color:var(--gl);font-style:normal;font-weight:700}
.about-p .italic{font-style:italic;color:var(--tm)}
.about-quote{
  margin:1.2rem 0;padding:1rem 1.2rem;
  border-right:3px solid var(--go);
  background:rgba(212,175,106,.06);
  border-radius:0 10px 10px 0;
  font-family:"Amiri",serif;font-size:1.1rem;
  color:var(--gl);line-height:1.8;font-style:italic;
}
.about-values{display:grid;grid-template-columns:1fr 1fr;gap:.65rem;padding:0 0 1rem}
.av-card{background:rgba(255,255,255,.03);border:1px solid var(--bdl);border-radius:var(--r);padding:.95rem .85rem;text-align:center;transition:all .2s}
.av-card:hover{border-color:var(--go);background:var(--gd)}
.av-ic{font-size:1.5rem;margin-bottom:.4rem}
.av-title{font-size:.78rem;font-weight:700;color:var(--gl);margin-bottom:.2rem}
.av-desc{font-size:.65rem;color:var(--tm);line-height:1.5}
.about-cta{margin:1.2rem 0;text-align:center;padding:1.5rem 1rem;background:rgba(212,175,106,.07);border:1px solid rgba(212,175,106,.18);border-radius:var(--rl)}
.about-cta-t{font-family:"Amiri",serif;font-size:1.2rem;color:var(--gl);margin-bottom:.35rem}
.about-cta-s{font-size:.75rem;color:var(--tm);margin-bottom:.85rem}
/* ══ TEACHER PROFILE ══ */
.tp-cover{height:120px;background:linear-gradient(135deg,var(--navy2),rgba(212,175,106,.2));position:relative;overflow:hidden}
.tp-cover::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 25% 50%,rgba(212,175,106,.15),transparent)}
.tp-av{width:82px;height:82px;border-radius:50%;border:3px solid var(--go);position:absolute;bottom:-30px;right:1.2rem;overflow:hidden;background:var(--navy2);display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:700;font-family:'Amiri',serif}
.tp-av img{width:100%;height:100%;object-fit:cover}
.tp-info{padding:2.2rem 1rem .8rem}
.tp-name{font-size:1.05rem;font-weight:700;margin-bottom:.18rem}
.tp-spec{font-size:.72rem;color:var(--gl);margin-bottom:.28rem}
.tp-meta{display:flex;gap:.7rem;flex-wrap:wrap;font-size:.65rem;color:var(--tm);margin-bottom:.65rem}
.tp-meta span{display:flex;align-items:center;gap:.22rem}
.tp-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem;margin-bottom:.85rem}
.tp-stat{background:rgba(255,255,255,.04);border:1px solid var(--bdl);border-radius:10px;padding:.6rem;text-align:center}
.tp-sn{font-size:1.1rem;font-weight:700;color:var(--gl)}
.tp-sl{font-size:.6rem;color:var(--tm)}
.tp-video{position:relative;padding-bottom:56.25%;border-radius:12px;overflow:hidden;margin-bottom:.85rem;background:#000}
.tp-video iframe{position:absolute;inset:0;width:100%;height:100%;border:none}
.tp-video-ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:.5rem;background:rgba(255,255,255,.03);cursor:pointer}
.tp-langs{display:flex;gap:.3rem;flex-wrap:wrap;margin-bottom:.65rem}
.tp-lang{font-size:.62rem;background:rgba(212,175,106,.1);border:1px solid rgba(212,175,106,.2);color:var(--gl);padding:.15rem .48rem;border-radius:100px}
.tp-bio{font-size:.78rem;color:var(--wh);line-height:1.75;margin-bottom:.85rem}
.tp-avail{display:grid;grid-template-columns:repeat(7,1fr);gap:.28rem;margin-bottom:.85rem}
.tp-day{background:rgba(255,255,255,.04);border:1px solid var(--bdl);border-radius:8px;padding:.4rem .2rem;text-align:center;font-size:.58rem}
.tp-day.on{background:rgba(39,174,96,.12);border-color:rgba(39,174,96,.3);color:var(--grl)}
.tp-day-nm{font-weight:700;margin-bottom:.15rem}
.tp-day-sl{font-size:.52rem;color:var(--tm)}
.tp-reviews{display:flex;flex-direction:column;gap:.55rem}
.tp-rev{background:rgba(255,255,255,.03);border:1px solid var(--bdl);border-radius:11px;padding:.8rem .9rem}
.tp-rev-hd{display:flex;align-items:center;gap:.55rem;margin-bottom:.4rem}
.tp-rev-av{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--go),var(--gl));display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;color:var(--navy);flex-shrink:0}
.tp-rev-nm{font-size:.76rem;font-weight:700}
.tp-rev-dt{font-size:.6rem;color:var(--tm)}
.tp-rev-stars{font-size:.7rem;color:var(--go)}
.tp-rev-txt{font-size:.74rem;color:var(--wh);line-height:1.65;font-style:italic}

/* ══ TEACHER DISCOVERY ══ */
.td-filters{padding:.65rem 1rem;display:flex;gap:.38rem;overflow-x:auto;scrollbar-width:none}
.td-filters::-webkit-scrollbar{display:none}
.td-filter{flex-shrink:0;padding:.32rem .72rem;border-radius:100px;font-size:.67rem;font-weight:600;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.04);color:var(--tm);cursor:pointer;transition:all .2s;font-family:'Cairo',sans-serif}
.td-filter.on{background:var(--go);border-color:var(--go);color:var(--navy)}
.td-sort{padding:0 1rem .55rem;display:flex;align-items:center;gap:.5rem}
.td-sort select{flex:1;background:rgba(255,255,255,.06);border:1px solid var(--bdl);border-radius:10px;color:#fff;font-family:'Cairo',sans-serif;font-size:.72rem;padding:.38rem .6rem}
.td-grid{display:flex;flex-direction:column;gap:.65rem;padding:0 1rem 1rem}
.tc-card{background:rgba(255,255,255,.035);border:1px solid var(--bdl);border-radius:16px;overflow:hidden;transition:all .25s;cursor:pointer}
.tc-card:hover,.tc-card:active{border-color:rgba(212,175,106,.4);transform:translateY(-2px)}
.tc-card-hd{display:flex;gap:.75rem;padding:.85rem .9rem .6rem}
.tc-av{width:56px;height:56px;border-radius:50%;flex-shrink:0;overflow:hidden;background:linear-gradient(135deg,var(--go),var(--gl));display:flex;align-items:center;justify-content:center;font-size:1.3rem;font-weight:700;color:var(--navy);border:2px solid rgba(212,175,106,.25);position:relative}
.tc-av img{width:100%;height:100%;object-fit:cover}
.tc-online{position:absolute;bottom:1px;right:1px;width:12px;height:12px;background:#25d366;border-radius:50%;border:2px solid var(--navy)}
.tc-info{flex:1;min-width:0}
.tc-name{font-size:.85rem;font-weight:700;margin-bottom:.12rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tc-spec{font-size:.65rem;color:var(--gl);margin-bottom:.25rem}
.tc-rating{font-size:.68rem;color:var(--go)}
.tc-rating span{color:var(--tm);font-size:.6rem}
.tc-card-bd{padding:0 .9rem .85rem;display:flex;flex-direction:column;gap:.45rem}
.tc-langs{display:flex;gap:.28rem;flex-wrap:wrap}
.tc-lang{font-size:.58rem;background:rgba(255,255,255,.06);border-radius:5px;padding:.08rem .32rem;color:var(--tm)}
.tc-bio-preview{font-size:.71rem;color:var(--tm);line-height:1.55;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.tc-card-ft{display:flex;align-items:center;justify-content:space-between;padding-top:.5rem;border-top:1px solid rgba(255,255,255,.05)}
.tc-price{font-size:.88rem;font-weight:700;color:var(--gl)}
.tc-price span{font-size:.62rem;color:var(--tm);font-weight:400}
.tc-fav{font-size:1.1rem;cursor:pointer;transition:transform .2s}
.tc-fav:active{transform:scale(1.3)}
.tc-badge{position:absolute;top:.45rem;left:.45rem;font-size:.52rem;font-weight:700;padding:.1rem .38rem;border-radius:100px;background:rgba(212,175,106,.2);color:var(--gl)}

/* ══ RATING MODAL ══ */
.stars-input{display:flex;gap:.5rem;justify-content:center;margin:1rem 0}
.star-btn{font-size:2rem;cursor:pointer;transition:transform .15s;opacity:.35;border:none;background:none}
.star-btn.on{opacity:1}
.star-btn:hover{transform:scale(1.2)}

/* ══ CERTIFICATE ══ */
.cert-wrap{background:linear-gradient(135deg,#071812,#0F3D2E);border:2px solid var(--go);border-radius:16px;margin:1rem;padding:1.5rem;text-align:center;position:relative;overflow:hidden}
.cert-wrap::before,.cert-wrap::after{content:'';position:absolute;border-radius:50%;opacity:.05}
.cert-wrap::before{width:200px;height:200px;background:var(--go);top:-80px;right:-80px}
.cert-wrap::after{width:150px;height:150px;background:var(--go);bottom:-60px;left:-60px}
.cert-logo{font-size:2.5rem;margin-bottom:.5rem}
.cert-mn{font-family:'Amiri',serif;font-size:1.1rem;color:var(--gl);margin-bottom:.15rem}
.cert-title{font-size:.75rem;color:var(--tm);margin-bottom:1rem}
.cert-hdr{font-size:.78rem;color:var(--tm);margin-bottom:.3rem}
.cert-name{font-family:'Amiri',serif;font-size:1.6rem;font-weight:700;color:#fff;margin-bottom:.8rem}
.cert-course{font-size:.8rem;color:var(--wh);margin-bottom:.3rem}
.cert-course strong{color:var(--gl)}
.cert-date{font-size:.68rem;color:var(--tm);margin-bottom:1rem}
.cert-seal{font-size:2.5rem;margin-bottom:.5rem}
.cert-id{font-size:.58rem;color:var(--td);font-family:monospace}

/* ══ PROGRESS ══ */
.prog-card{background:rgba(255,255,255,.03);border:1px solid var(--bdl);border-radius:14px;padding:1rem;margin-bottom:.65rem}
.prog-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:.65rem}
.prog-subj{font-size:.82rem;font-weight:700}
.prog-pct{font-size:.8rem;font-weight:700;color:var(--gl)}
.prog-bar{height:8px;background:rgba(255,255,255,.07);border-radius:100px;overflow:hidden;margin-bottom:.4rem}
.prog-fill{height:100%;border-radius:100px;background:linear-gradient(90deg,var(--go),var(--gl));transition:width .5s ease}
.prog-meta{display:flex;justify-content:space-between;font-size:.62rem;color:var(--tm)}

/* ══ FAVORITES ══ */
.fav-empty{text-align:center;padding:2rem;color:var(--tm)}

/* ══ PROMO ══ */
.promo-row{display:flex;gap:.5rem;margin-bottom:.65rem}
.promo-row input{flex:1}
.promo-row button{flex-shrink:0}
.promo-applied{background:rgba(39,174,96,.1);border:1px solid rgba(39,174,96,.25);border-radius:10px;padding:.5rem .75rem;font-size:.72rem;color:var(--grl);display:flex;align-items:center;justify-content:space-between;margin-bottom:.65rem}

/* ══ REFERRAL ══ */
.ref-card{background:linear-gradient(135deg,rgba(212,175,106,.12),rgba(212,175,106,.04));border:1.5px solid rgba(212,175,106,.3);border-radius:16px;padding:1.2rem;margin-bottom:.9rem;text-align:center}
.ref-code{font-family:monospace;font-size:1.4rem;font-weight:700;color:var(--gl);letter-spacing:3px;background:rgba(0,0,0,.2);border-radius:10px;padding:.5rem 1rem;margin:.65rem 0;display:inline-block}

/* ══ LIVE CLASS ══ */
.lc-room{background:#000;border-radius:14px;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;margin-bottom:.85rem;position:relative;overflow:hidden}
.lc-room-inner{text-align:center;color:var(--tm)}
.lc-controls{display:flex;gap:.65rem;justify-content:center;margin-bottom:.85rem}
.lc-btn{width:50px;height:50px;border-radius:50%;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.2rem;transition:all .2s}
.lc-btn.mic{background:rgba(255,255,255,.1)}
.lc-btn.mic.off{background:rgba(192,57,43,.3)}
.lc-btn.cam{background:rgba(255,255,255,.1)}
.lc-btn.cam.off{background:rgba(192,57,43,.3)}
.lc-btn.end{background:rgba(192,57,43,.8);color:#fff}
.lc-btn.share{background:rgba(52,152,219,.3)}
.lc-chat{background:rgba(255,255,255,.03);border:1px solid var(--bdl);border-radius:12px;height:200px;overflow-y:auto;padding:.65rem;margin-bottom:.5rem;display:flex;flex-direction:column;gap:.4rem}
.lc-msg{font-size:.73rem;line-height:1.5}
.lc-msg strong{color:var(--gl)}
.lc-msg-input{display:flex;gap:.5rem}


/* ══ TEACHER SCHEDULE ══ */
.sch-day{background:rgba(255,255,255,.03);border:1px solid var(--bdl);border-radius:12px;margin-bottom:.55rem;overflow:hidden}
.sch-day-hd{padding:.65rem .9rem;display:flex;align-items:center;justify-content:space-between;cursor:pointer}
.sch-day-nm{font-size:.8rem;font-weight:700}
.sch-day-cnt{font-size:.65rem;color:var(--tm)}
.sch-slots{padding:.5rem .9rem .65rem;display:flex;flex-direction:column;gap:.38rem}
.sch-slot{display:flex;align-items:center;gap:.6rem;padding:.55rem .7rem;background:rgba(255,255,255,.04);border:1px solid var(--bdl);border-radius:9px;font-size:.74rem}
.sch-slot.booked{border-color:rgba(212,175,106,.3);background:rgba(212,175,106,.06)}
.sch-slot.free{border-color:rgba(39,174,96,.2);background:rgba(39,174,96,.04)}
.sch-time{font-weight:700;flex-shrink:0;width:55px}
.sch-info{flex:1}
.sch-student{font-size:.72rem;font-weight:600;color:var(--gl)}
.sch-subj{font-size:.62rem;color:var(--tm)}
.sch-actions{display:flex;gap:.3rem}
/* ══ PWA INSTALL ══ */
.pwa-banner{position:fixed;bottom:70px;left:.75rem;right:.75rem;background:linear-gradient(135deg,#155C43,#0A2A20);border:1.5px solid rgba(212,175,106,.4);border-radius:16px;padding:.85rem 1rem;display:flex;align-items:center;gap:.75rem;z-index:999;box-shadow:0 8px 32px rgba(0,0,0,.5);animation:slideUp .4s ease}
@keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}
.pwa-ic{font-size:2rem;flex-shrink:0}
.pwa-txt{flex:1}
.pwa-t{font-size:.78rem;font-weight:700;margin-bottom:.12rem}
.pwa-s{font-size:.65rem;color:var(--tm)}
.pwa-close{background:none;border:none;color:var(--tm);font-size:1.1rem;cursor:pointer;flex-shrink:0;padding:.2rem}
/* ══ PAYMENT METHODS ══ */
.pay-methods{display:flex;flex-direction:column;gap:.5rem;margin-bottom:.85rem}
.pay-method{display:flex;align-items:center;gap:.7rem;background:rgba(255,255,255,.04);border:1.5px solid var(--bdl);border-radius:12px;padding:.75rem .9rem;cursor:pointer;transition:all .2s}
.pay-method.selected{border-color:var(--go);background:rgba(212,175,106,.08)}
.pay-method-ic{font-size:1.4rem;flex-shrink:0}
.pay-method-nm{font-size:.8rem;font-weight:700}
.pay-method-ds{font-size:.63rem;color:var(--tm)}
.pay-method input[type=radio]{accent-color:var(--go);margin-right:auto}

.ai-fab{position:fixed;bottom:5rem;left:1rem;width:48px;height:48px;min-width:48px;border-radius:50%;background:linear-gradient(135deg,#7C3AED,#9b59b6);border:2px solid rgba(255,255,255,.15);font-size:1.3rem;line-height:48px;text-align:center;color:#fff;box-shadow:0 5px 18px rgba(109,40,217,.5);cursor:pointer;z-index:9999;padding:0;margin:0;overflow:hidden;box-sizing:border-box}

.flash-card-wrap{perspective:1000px;height:180px;margin:1rem}
.flash-card{width:100%;height:100%;transform-style:preserve-3d;transition:transform .5s;cursor:pointer;position:relative}
.flash-card.flipped{transform:rotateY(180deg)}
.card-face{position:absolute;inset:0;backface-visibility:hidden;border-radius:18px;display:flex;align-items:center;justify-content:center;padding:1.5rem;font-size:1.1rem;font-weight:700;text-align:center;line-height:1.5}
.card-front{background:linear-gradient(135deg,rgba(212,175,106,.15),rgba(212,175,106,.05));border:1px solid rgba(212,175,106,.25)}
.card-back{background:linear-gradient(135deg,rgba(39,174,96,.15),rgba(39,174,96,.05));border:1px solid rgba(39,174,96,.25);transform:rotateY(180deg);font-size:.82rem;font-weight:400}


.ai-chat-panel{position:fixed;bottom:0;left:0;right:0;height:85vh;background:linear-gradient(160deg,#0a0f1e,#060a14);border-radius:22px 22px 0 0;border:1px solid rgba(108,63,197,.25);z-index:9980;transform:translateY(100%);transition:transform .4s cubic-bezier(.34,1.56,.64,1);display:flex;flex-direction:column}
.ai-chat-panel.on{transform:translateY(0)}
.xp-notif{position:fixed;top:1rem;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--go),var(--gl));color:var(--navy);padding:.45rem 1rem;border-radius:100px;font-size:.72rem;font-weight:700;z-index:9999;opacity:0;transition:opacity .3s;pointer-events:none}
.xp-notif.show{opacity:1}


.lib-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.5rem}
.lib-card{background:rgba(255,255,255,.04);border:1px solid var(--bdl);border-radius:12px;padding:.8rem .6rem .65rem;text-align:center;cursor:pointer;transition:border-color .2s,transform .15s}
.lib-card:hover,.lib-card:active{border-color:rgba(212,175,106,.3);transform:scale(.97)}
.lib-ic{font-size:1.6rem;margin-bottom:.35rem}
.lib-nm{font-size:.68rem;font-weight:700;line-height:1.35;margin-bottom:.2rem}
.lib-au{font-size:.58rem;color:var(--tm)}

\n/* ═══════════════════════════════════════════════════════════════\n   V11 — Production hardening and modern polish: accessibility, safe areas, motion,\n   touch targets, connection state and premium visual hierarchy.\n   This layer intentionally avoids changing business logic/layout contracts.\n   ═══════════════════════════════════════════════════════════════ */\n.skip-link{position:fixed;top:-60px;right:1rem;z-index:10000;background:var(--go);color:var(--navy);padding:.55rem .85rem;border-radius:0 0 10px 10px;font-size:.75rem;font-weight:800;text-decoration:none;transition:top .2s}.skip-link:focus{top:0}\n:focus-visible{outline:2px solid var(--go);outline-offset:3px}\nbutton,a,input,select,textarea{touch-action:manipulation}\nbutton,.btn,.ib,.ni{min-height:34px}\nhtml{scroll-behavior:smooth}\n::selection{background:rgba(212,175,106,.35);color:#fff}\nbody{padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom);}\nnav{padding-bottom:env(safe-area-inset-bottom);height:calc(var(--nh) + env(safe-area-inset-bottom))}\n.pg{padding-bottom:calc(var(--nh) + env(safe-area-inset-bottom) + .75rem)}\n.connection-status{position:fixed;top:calc(var(--hh) + env(safe-area-inset-top) + .5rem);left:50%;transform:translateX(-50%);z-index:9998;width:min(92vw,520px);padding:.55rem .8rem;border:1px solid rgba(192,57,43,.35);background:rgba(75,20,18,.94);color:#ffd6d2;border-radius:12px;text-align:center;font-size:.68rem;font-weight:700;box-shadow:0 10px 30px rgba(0,0,0,.35);backdrop-filter:blur(16px)}\n.connection-status[hidden]{display:none}\n.teacher-directory-intro{margin:0 1rem .8rem;padding:.8rem .85rem;border:1px solid rgba(212,175,106,.2);background:linear-gradient(135deg,rgba(212,175,106,.09),rgba(255,255,255,.025));border-radius:14px;display:flex;align-items:center;justify-content:space-between;gap:.75rem}\n.loading-state,.empty-state{margin:.65rem 1rem;padding:1.2rem;text-align:center;border:1px dashed var(--bd);border-radius:14px;color:var(--tm);font-size:.72rem;background:rgba(255,255,255,.025)}\n.spinner{display:inline-block;width:18px;height:18px;border:2px solid rgba(255,255,255,.14);border-top-color:var(--go);border-radius:50%;vertical-align:middle;margin-left:.45rem;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}\n.home-footer,.hib,.crs-card,.tc-card,.book-card,.av-card,.prc-c,.testi,.faq-i,.trust-item,.cta-banner{box-shadow:0 1px 0 rgba(255,255,255,.02),0 10px 30px rgba(0,0,0,.12)}\n.srch,.fc,.btn,.ib,.ni,.lang-card,.subj-card,.skill-card,.exam-card{transition:transform .18s ease,border-color .18s ease,background-color .18s ease,box-shadow .18s ease}\n.btn:active,.ib:active,.ni:active{transform:scale(.98)}\n@media (min-width:700px){header{padding-inline:1.5rem}.pg{padding-inline:clamp(1rem,4vw,3rem)}.hero,.srchw,.subj-grid,.trust-strip,.faq-wr,.home-footer{max-width:980px;margin-inline:auto}.home-footer{margin-bottom:1rem}.teacher-directory-intro{max-width:980px;margin-inline:auto}.pwa-banner{max-width:760px;left:50%;right:auto;transform:translateX(-50%);width:calc(100% - 2rem)}}\n@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.001ms!important}.ticker-inner{animation:none}}\n@media (prefers-contrast:more){:root{--bd:rgba(240,217,168,.48);--bdl:rgba(240,217,168,.28);--tm:#b7c5d0;--td:#86a692}}\n</style><script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"EducationalOrganization",
  "name":"منارة المعرفة",
  "alternateName":"Manarat Al-Maarifa",
  "url":"https://manarat-almaarifa.com/",
  "description":"منصة تعليمية للدروس الفردية في القرآن الكريم واللغة العربية والعلوم الشرعية واللغات.",
  "areaServed":"Worldwide",
  "availableLanguage":["ar","en","fr","es","de","nl","tr","it","pt","id"]
}
</script>

<style id="v17-fixes">
/* ===== V17 — إصلاحات تخطيط، إضافية فقط ولا تعدّل أي قاعدة أصلية ===== */
/* 1) الترويسة: منع أي عنصر من الطفو فوق الشعار أو تجاوز عرض الشاشة */
header{overflow:hidden}
header>*{min-width:0}
.lo-t{min-width:0;overflow:hidden}
.lo-t .ar,.lo-t .en{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hm{min-width:0;overflow:hidden}
.live{white-space:nowrap;max-width:38vw;overflow:hidden;text-overflow:ellipsis}
/* 2) زر اللغة: عرض كافٍ فلا يظهر جزء مبتور من اسم اللغة */
#lsel{width:78px!important;text-align:start!important;font-size:.6rem!important;padding:.22rem .34rem!important;text-overflow:ellipsis}
@media(max-width:380px){#lsel{width:62px!important;font-size:.56rem!important}}
/* 3) الإشعارات: فوق شريط التنقل بدل تغطية الترويسة وأزرارها */
#tc{top:auto!important;bottom:calc(var(--nh,58px) + env(safe-area-inset-bottom) + .85rem)!important}
#tc>*{box-shadow:0 10px 30px rgba(0,0,0,.45)}
/* 4) شاشات الإدارة: منع تراكب أدوات البحث والتصفية على الشاشات الضيقة */
@media(max-width:430px){
  .ainp{flex:1 1 100%!important;min-width:0!important}
  #adm-add-user,#adm-users-list .btn{flex:1 1 100%!important}
}
/* 5) نافذة الإدارة: إبقاء زرّي الحفظ والإلغاء داخل المساحة القابلة للوصول */
#adm-v8-box{max-height:88dvh!important;padding-bottom:calc(1rem + env(safe-area-inset-bottom))!important}
/* 6) رابط تخطّي المحتوى: إخفاء مؤكَّد حتى التركيز بلوحة المفاتيح */
.skip-link:not(:focus):not(:focus-visible){clip-path:inset(50%);width:1px;height:1px;padding:0;overflow:hidden}
</style>
<style id="launch-badge-v20">body.no-launch-badge .live,body.no-launch-badge .h-badge{display:none!important}</style>
<style id="domain-strip-v20">
.dom-strip{position:relative;overflow:hidden;margin:1.15rem 1rem .5rem;padding:1.45rem 1.15rem 1.25rem;border-radius:24px;text-align:center;
  background:radial-gradient(120% 85% at 50% 0%,rgba(212,175,106,.17),transparent 62%),linear-gradient(160deg,rgba(15,61,46,.94),rgba(7,24,18,.97));
  border:1px solid rgba(212,175,106,.38);box-shadow:0 14px 40px rgba(0,0,0,.35),inset 0 1px 0 rgba(240,217,168,.14)}
.dom-strip::before{content:'';position:absolute;inset:0;opacity:.07;pointer-events:none;
  background-image:repeating-conic-gradient(from 22.5deg,#F0D9A8 0 12.5%,transparent 0 25%);background-size:30px 30px;
  -webkit-mask-image:radial-gradient(circle at 50% 35%,#000 0,transparent 72%);mask-image:radial-gradient(circle at 50% 35%,#000 0,transparent 72%)}
.dom-strip>*{position:relative}
.dom-orn{display:block;width:36px;height:36px;margin:0 auto .55rem;filter:drop-shadow(0 4px 10px rgba(212,175,106,.35))}
.dom-kick{font-size:.62rem;letter-spacing:.14em;color:#D4AF6A;font-weight:700;margin-bottom:.4rem}
.dom-t{font-family:'Amiri',serif;font-size:1.32rem;line-height:1.6;color:#fff;font-weight:700}
.dom-t b{color:#F0D9A8}
.dom-s{font-size:.7rem;color:var(--tm);margin-top:.45rem;line-height:1.75}
.dom-chips{display:flex;flex-wrap:wrap;justify-content:center;gap:.42rem;margin:1rem 0 1.05rem}
.dom-chip{font-size:.66rem;font-weight:700;color:#fff;padding:.4rem .85rem;border-radius:999px;border:1px solid rgba(212,175,106,.38);background:rgba(212,175,106,.09);cursor:pointer;transition:transform .15s}
.dom-chip:active{transform:scale(.96)}
.dom-btn{display:inline-flex;align-items:center;gap:.55rem;padding:.72rem 1.6rem;border:none;border-radius:999px;background:linear-gradient(135deg,#D4AF6A,#F0D9A8);color:#0b2a20;font-family:inherit;font-weight:800;font-size:.82rem;cursor:pointer;box-shadow:0 8px 24px rgba(212,175,106,.38)}
.dom-btn:active{transform:scale(.97)}
</style>
<style id="pricing-strip-v20">
.prc-strip{position:relative;overflow:hidden;margin:0 1rem;padding:1.15rem 1.05rem 1.2rem;border-radius:22px;
  background:linear-gradient(155deg,rgba(212,175,106,.1),rgba(255,255,255,.02) 55%,rgba(0,0,0,.18));
  border:1px solid rgba(212,175,106,.3);box-shadow:0 12px 34px rgba(0,0,0,.3)}
.prc-glow{position:absolute;top:-45%;left:-25%;width:75%;height:160%;pointer-events:none;
  background:radial-gradient(circle,rgba(212,175,106,.2),transparent 65%)}
.prc-strip>*{position:relative}
.prc-free{display:flex;align-items:center;gap:.7rem;padding:.7rem .8rem;border-radius:15px;
  background:linear-gradient(135deg,rgba(39,174,96,.2),rgba(39,174,96,.06));border:1px solid rgba(39,174,96,.4)}
.prc-free-ic{font-size:1.7rem;line-height:1}
.prc-free b{display:block;font-size:.92rem;font-weight:800;color:#fff;line-height:1.5}
.prc-free small{display:block;font-size:.64rem;color:var(--tm);line-height:1.65;margin-top:.1rem}
.prc-note{font-size:.72rem;line-height:1.95;color:var(--tm);margin-top:.85rem}
.prc-note b{color:#F0D9A8}
.prc-chips{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.9rem}
.prc-chip{font-size:.63rem;font-weight:700;color:#fff;padding:.35rem .7rem;border-radius:999px;
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1)}
.prc-btn{display:flex;align-items:center;justify-content:center;gap:.5rem;width:100%;margin-top:1.05rem;
  padding:.82rem;border:none;border-radius:14px;background:linear-gradient(135deg,#D4AF6A,#F0D9A8);
  color:#0b2a20;font-family:inherit;font-size:.82rem;font-weight:800;cursor:pointer;box-shadow:0 8px 22px rgba(212,175,106,.32)}
.prc-btn:active{transform:scale(.98)}
</style>
</head><body>
<a class="skip-link" href="#cnt">تخطَّ إلى المحتوى</a>
<div id="connection-status" class="connection-status" role="status" aria-live="polite" hidden></div><div id="tc"></div>
<div id="app">
<header>
  <div style="width:38px;height:38px;flex-shrink:0;display:flex;align-items:center;justify-content:center">
<svg width="38" height="38" viewBox="0 0 38 38" xmlns="http://www.w3.org/2000/svg">
<defs>
<linearGradient id="lhGold" x1="20%" y1="0%" x2="80%" y2="100%">
<stop offset="0%" stop-color="#F0D9A8"/><stop offset="50%" stop-color="#D4AF6A"/><stop offset="100%" stop-color="#0F3D2E"/>
</linearGradient>
<radialGradient id="lhGlow" cx="50%" cy="20%" r="60%">
<stop offset="0%" stop-color="#F0D9A8" stop-opacity=".4"/><stop offset="100%" stop-color="#F0D9A8" stop-opacity="0"/>
</radialGradient>
</defs>
<ellipse cx="19" cy="9" rx="13" ry="7" fill="url(#lhGlow)"/>
<g transform="translate(19,20)">
<rect x="-8" y="12" width="16" height="5" rx="2.5" fill="url(#lhGold)" opacity=".8"/>
<rect x="-7" y="9" width="14" height="4" rx="2" fill="url(#lhGold)" opacity=".9"/>
<path d="M-7,9 L-4,-10 C-3,-11 3,-11 4,-10 L7,9 Z" fill="url(#lhGold)" opacity=".92"/>
<rect x="-2" y="-6" width="4" height="7" rx="2" fill="rgba(255,245,180,.15)" stroke="rgba(255,230,100,.3)" stroke-width=".5"/>
<rect x="-8" y="-12" width="16" height="3.5" rx="1.75" fill="url(#lhGold)"/>
<rect x="-5" y="-15" width="10" height="4" rx="2" fill="url(#lhGold)"/>
<path d="M-4.5,-15 L0,-22 L4.5,-15 Z" fill="url(#lhGold)"/>
<g transform="translate(-4,-24.5)">
<path d="M-4,-2.5 A5.5,5.5 0 1,1 4,-2.5 A4,4 0 1,0 -4,-2.5" fill="url(#lhGold)"/>
</g>
<g transform="translate(4,-26)">
<polygon points="0,-3.5 1,-1.1 3.5,-1.1 1.8,.7 2.4,3.2 0,1.9 -2.4,3.2 -1.8,.7 -3.5,-1.1 -1,-1.1" fill="url(#lhGold)"/>
</g>
<line x1="0" y1="-22" x2="0" y2="-26" stroke="url(#lhGold)" stroke-width="1.5" stroke-linecap="round" opacity=".75"/>
<line x1="0" y1="-22" x2="-5" y2="-25" stroke="url(#lhGold)" stroke-width="1" stroke-linecap="round" opacity=".4"/>
<line x1="0" y1="-22" x2="5" y2="-25" stroke="url(#lhGold)" stroke-width="1" stroke-linecap="round" opacity=".4"/>
</g>
</svg>
</div>
  <div class="lo-t"><span class="ar">منارة المعرفة</span><span class="en">Manarat Al-Maarifa</span></div>
  <div class="hm">
    <div class="live"><div class="ldot"></div>نحن في مرحلة الإطلاق 🚀</div>
